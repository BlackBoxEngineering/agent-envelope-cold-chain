# AgentEnvelope hosted API. Copy this file to .env.local for local use.
VITE_AE_API_BASE=https://jemdjwteae.execute-api.us-east-1.amazonaws.com/v1
VITE_AE_API_KEY=
VITE_AE_OWNER_USER_ID=

# Create the three runtime delegates in the AgentEnvelope portal, download their
# handoff JSON into the matching mint-delegate.*.json file. Copy the one-time
# mint material from the portal and generate a separate worker bot key per role.
VITE_AE_MONITOR_BOT_KEY=
VITE_AE_MONITOR_MINT_MATERIAL=
VITE_AE_DISPATCH_BOT_KEY=
VITE_AE_DISPATCH_MINT_MATERIAL=
VITE_AE_ENGINEER_BOT_KEY=
VITE_AE_ENGINEER_MINT_MATERIAL=

# VITE_ values are bundled into browser code. Use these only for this demo and
# never commit populated values. Production runtimes should hold secrets outside
# the browser and call the hosted API from their trusted execution boundary.
